# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# --- Supabase (auth) — wired up in Phase C ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AgentOS backend ---
# In dev, leave as `/agentos` so the Vite proxy forwards to http://localhost:7777
# (see vite.config.ts). In prod, set this to the real backend origin.
VITE_AGENTOS_URL=/agentos

# --- Market ---
# Which equities market the whole app targets: "us" (default) or "in".
# Drives currency, exchanges, example tickers, copy and which ticker index loads
# (public/tickers.<market>.json — regenerate with `npm run build:tickers:us|in`).
VITE_MARKET=us

# --- Site ---
# Support / contact address used by the Contact page and account-deletion flow.
VITE_SUPPORT_EMAIL=hello@hakisense.app
